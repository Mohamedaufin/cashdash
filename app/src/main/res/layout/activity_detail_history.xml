<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/mainBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="50dp"
    android:paddingBottom="0dp">

    <ImageView
        style="@style/Widget.Cashdash.BackButton"
        android:id="@+id/btnBack"
        app:tint="?attr/textPrimaryColor" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:text="Breakdown"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.cash.dash.CategoryBreakdownGraphView
        android:id="@+id/categoryGraph"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="20dp" />

    <TextView
        android:text="History"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_title"
        android:layout_marginTop="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvReceiptHint"
        android:text="Tap any scanned transaction to view its receipt"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_hint"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvEditHint"
        android:text="Press and hold on any transaction to edit it"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_hint"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- The list and the empty state occupy the same flex slot; the activity toggles
         visibility between them. Wrap both in a FrameLayout so the empty state can
         center itself in exactly the space the list would have used. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="120dp"
            android:clipToPadding="false" />

        <include
            android:id="@+id/emptyStateContainer"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>
