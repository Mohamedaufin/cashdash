<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyStateContainer"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Decorative: the adjacent title and subtitle carry the meaning. -->
    <ImageView
        android:id="@+id/imgEmptyState"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_paper_sheet"
        app:tint="?attr/textMutedColor"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No transactions here yet"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/text_subhead"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="Scan a QR payment or log a manual expense and it will show up here."
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body" />

</LinearLayout>
