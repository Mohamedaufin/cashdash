<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Menu button -->
    <ImageView
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:padding="11dp"
        android:src="@drawable/ic_glass_menu_vector"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <!-- Greeting -->
    <TextView
        android:id="@+id/tvUsernameHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="16dp"
        android:textColor="?attr/textPrimaryColor"
        android:textSize="@dimen/top_greeting_text"
        android:textStyle="bold"
        android:transitionName="greeting_text_transition"
        app:layout_constraintStart_toEndOf="@id/btnMenu"
        app:layout_constraintEnd_toStartOf="@+id/btnTaptrack"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu" />



    <!-- Taptrack button -->
    <ImageView
        android:id="@+id/btnTaptrack"
        android:layout_width="@dimen/top_icon_size"
        android:layout_height="@dimen/top_icon_size"
        android:padding="4dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_taptrack_icon"
        app:tint="?attr/textPrimaryColor"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="TapTrack"
        app:layout_constraintEnd_toStartOf="@+id/btnSmartAssistant"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu"/>

    <!-- Smart Assistant button -->
    <ImageView
        android:id="@+id/btnSmartAssistant"
        android:layout_width="@dimen/top_icon_size"
        android:layout_height="@dimen/top_icon_size"
        android:padding="4dp"
        android:layout_marginEnd="16dp"
        android:src="?attr/finminderIcon"
        app:tint="?attr/textPrimaryColor"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Finminder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu"/>


    <LinearLayout
        android:id="@+id/layoutTopTexts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/walletContainer"
        app:layout_constraintTop_toBottomOf="@id/tvUsernameHome"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvNextMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next money in 0 days"
            android:textColor="?attr/textMutedColor"
            android:textSize="@dimen/text_body"
            android:gravity="center_vertical"
            android:drawableEnd="@drawable/ic_chevron_end"
            android:drawableTint="?attr/textMutedColor"
            android:drawablePadding="4dp"
            android:paddingHorizontal="8dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvResetPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Scheduled reset is pending. Tap text to configure."
            android:textColor="?attr/textRedColor"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
    <!-- WALLET CIRCLE -->
    <FrameLayout
        android:id="@+id/walletContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="340dp"
        app:layout_constraintHeight_max="340dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/tvUsernameHome"
        app:layout_constraintBottom_toTopOf="@id/cardScanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/wallet_ring_margin_top"
        android:layout_marginBottom="24dp">

        <com.cash.dash.GradientCircularProgressView
            android:id="@+id/walletProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp">
            <TextView
                android:id="@+id/tvWalletLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Wallet balance"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeStepGranularity="1sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="5dp"
                android:text="₹5000"
                android:textColor="?attr/textPrimaryColor"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvBalanceCycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="of ₹2000 this cycle"
                android:textColor="?attr/textMutedColor"
                android:textSize="@dimen/text_body"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeStepGranularity="1sp"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/tvTodaySummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="14dp"
        android:textColor="?attr/textMutedColor"
        android:textSize="@dimen/text_body"
        app:layout_constraintBottom_toTopOf="@id/cardScanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ACTION CARDS -->
    <LinearLayout
        android:id="@+id/cardScanner"
        android:layout_width="120dp"
        android:layout_height="110dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/cardBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/walletContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/iconScanner"
            android:layout_width="40dp"
            android:layout_height="65dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_scanner" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Scan &amp; Pay"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/cardRigor"
        android:layout_width="120dp"
        android:layout_height="110dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/cardBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/cardScanner"
        app:layout_constraintBottom_toBottomOf="@id/cardScanner"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iconRigorTracker"
            android:layout_width="85dp"
            android:layout_height="65dp"
            android:src="@drawable/ic_rigor_tracker"
            android:scaleType="fitCenter"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rigor Tracker"
            android:textColor="?attr/textPrimaryColor"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
