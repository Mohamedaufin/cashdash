    </style>



    <style name="Widget.Cashdash.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.Cashdash.Button.TextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Material3 parents, not AppCompat. The base theme is Theme.Material3, so the
         Material widgets are the right size and shape here; the AppCompat ones are
         narrower, which is what clipped the terms check box against its -12dp start
         margin. useMaterialThemeColors is off so the tint comes from the app's own
         tokens rather than the M3 colour roles this project never customised —
         those defaults are what rendered as a solid white block on the Blue theme. -->
    <style name="Widget.Cashdash.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="useMaterialThemeColors">false</item>
        <item name="buttonTint">@color/selector_checkbox_tint</item>
    </style>

    <style name="Widget.Cashdash.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="useMaterialThemeColors">false</item>
        <!-- Only the Material attribute, never android:buttonTint. The platform one
             tints the whole drawable as a single layer, so the box and the tick end
             up the same colour and the tick vanishes into a solid block. buttonTint
             colours the box, buttonIconTint colours the tick. -->
        <item name="buttonTint">@color/selector_checkbox_tint</item>
        <!-- The tick. The box is filled with textPrimaryColor, so the glyph has to be
             its inverse or it vanishes into the fill. -->
        <item name="buttonIconTint">?attr/checkboxTickColor</item>
    </style>

