<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Standardized Typography Scale (Max 5 sizes) -->
    <dimen name="text_headline">28sp</dimen> 
    <dimen name="text_title">20sp</dimen>    
    <dimen name="text_subhead">16sp</dimen>  
    <dimen name="text_body">14sp</dimen>     
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_action">15sp</dimen>
    <dimen name="text_small">11sp</dimen>
    <dimen name="text_micro">10sp</dimen>

    <!-- Locked Typography for Graphs (Fixed size, ignores system font scaling) -->
    <dimen name="graph_text_title">18dp</dimen>
    <dimen name="graph_text_subhead">15dp</dimen>
    <dimen name="graph_text_body">13dp</dimen>
    <dimen name="graph_text_caption">11dp</dimen>
    <dimen name="chip_stroke_width">1dp</dimen>

    <!--
      Spacing scale.

      Added because the layouts had drifted badly: 2,420 hardcoded dp values against 303
      @dimen references, which is why padding and gaps differ screen to screen for no reason.
      A 4dp-based scale is the Material baseline and covers essentially every gap in this app.

      Do not migrate every existing value at once — that is a large, risky sweep with no
      visible payoff. Use these in NEW layouts, and convert an old screen's values when you
      are already editing it for another reason.
    -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_xxl">48dp</dimen>

    <!--
      The minimum size any tappable view may be, per the Android accessibility guideline.

      This is a floor on the TOUCH TARGET, not on the artwork: an icon that should look 22dp
      stays 22dp by sitting inside a 48dp view with padding. Several controls in this app were
      built at the icon's size instead — a 15dp edit-balance pencil, 22dp attachment delete
      buttons — which made destructive actions the hardest things on screen to hit.
    -->
    <dimen name="touch_target_min">48dp</dimen>

    <!--
      Top bar and bottom nav only. These are the two blocks that squeeze the content
      when a screen is short, so they are the only things that shrink; values-h700dp
      holds the original sizes and this file is the reduced set for shorter screens.
    -->
    <dimen name="top_menu_size">26dp</dimen>
    <dimen name="top_icon_size">30dp</dimen>
    <dimen name="top_greeting_text">14sp</dimen>
    <dimen name="nav_icon_width">120dp</dimen>
    <dimen name="nav_icon_height">60dp</dimen>
    <!-- All normal UI text uses sp so accessibility font scaling remains reliable. -->
    <dimen name="text_hint">12sp</dimen>
    <dimen name="wallet_ring_margin_top">48dp</dimen>
</resources>
