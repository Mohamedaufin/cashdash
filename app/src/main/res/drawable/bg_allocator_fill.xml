<?xml version="1.0" encoding="utf-8"?>
<!-- Spend so far, comfortably inside the limit.

     Green is the bottom step of the budget ladder: amber warns from 80%, red once the
     limit is passed. The purple gloss this originally replaced carried no meaning and
     the off-white that followed carried none either — every row looked identical until
     it failed. Colour here answers "how close am I" before the figures are read. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/textGreenColor" />
    <corners android:radius="2dp" />
</shape>
