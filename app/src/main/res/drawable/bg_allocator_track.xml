<?xml version="1.0" encoding="utf-8"?>
<!-- Unfilled portion of an allocation's spend bar.

     Its own drawable rather than bg_glass_progress_outer, which carries a 28dp corner radius
     and a 1dp stroke sized for the much taller Rigor tracker bar. At 4dp tall that stroke is
     most of the bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/progressTrackColor" />
    <corners android:radius="2dp" />
</shape>
